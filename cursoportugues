/* ============ CASTLE MAP ============ */
function getCastleOrderedMarkers(){const arr=[];TEMPLES.forEach(t=>{arr.push({kind:'temple',temple:t});t.stages.forEach(c=>arr.push({kind:'castle',castle:c}));});arr.push({kind:'key'});arr.push({kind:'door'});return arr;}
function renderCastleMap(){
    const container=$('castleMapContainer');container.querySelectorAll('.temple-marker').forEach(el=>el.remove());
    const items=getCastleOrderedMarkers();const isMobile=window.innerWidth<=640;const cols=isMobile?2:4;const rows=Math.ceil(items.length/cols);const rowH=isMobile?205:240;
    container.style.height=(rows*rowH)+'px';const pts=[];const totalCastles=CASTLES.length;
    items.forEach((item,i)=>{
        const row=Math.floor(i/cols);let col=i%cols;if(row%2===1)col=cols-1-col;
        const xPct=((col+0.5)/cols)*100;const yPct=((row+0.5)/rows)*100;pts.push([xPct,yPct]);
        const el=document.createElement('div');el.className='temple-marker';el.style.left=xPct+'%';el.style.top=yPct+'%';
        if(item.kind==='temple'){
            const t=item.temple;const unlocked=isTempleUnlocked(t);const doneL=t.lessons.filter((l,idx)=>isCastleLessonDone(t.id,idx)).length;const prog=t.lessons.length?doneL/t.lessons.length:0;const allPassed=t.stages.every(c=>isCastlePassed(c.id));const tScale=0.95+((t.id-1)/(TEMPLES.length-1))*0.25;
            el.style.setProperty('--m-scale',tScale.toFixed(3));el.classList.add(allPassed?'complete':(unlocked?'open':'locked'));
            el.innerHTML=templeSVG(prog,'T'+t.id)+`<div class="temple-label"><span class="num">TEMPLO ${t.id}</span>${escHtml(t.title)}</div>`;
            el.addEventListener('click',()=>goCastleKingdom(t.id));
        }else if(item.kind==='castle'){
            const c=item.castle;const passed=isCastlePassed(c.id);const unlocked=isCastleUnlocked(c);const cScale=0.85+((c.number-1)/(totalCastles-1))*0.60;
            el.style.setProperty('--m-scale',cScale.toFixed(3));el.style.setProperty('--glow',(12+c.number*1.6).toFixed(1)+'px');
            el.classList.add(passed?'complete':(unlocked?'open':'locked'));
            el.innerHTML=castleSVG(passed,'C'+c.number)+`<div class="temple-label"><span class="num">CASTILLO ${c.number}</span>${escHtml(c.templeTitle)} · Etapa ${c.stageIndex+1}</div>`;
            el.addEventListener('click',()=>startCastleExercise(c.id));
        }else if(item.kind==='key'){
            const pct=keyPercent();const active=keyActive();
            el.style.setProperty('--m-scale','1.15');el.classList.add(active?'complete':(allCastlesPassed()?'open':'locked'));el.style.setProperty('--glow','22px');
            el.innerHTML=`<svg class="temple-svg" viewBox="0 0 120 160" xmlns="http://www.w3.org/2000/svg">${active?`<circle cx="60" cy="80" r="75" fill="rgba(52,211,153,0.15)"/>`:''}<circle cx="60" cy="55" r="28" fill="none" stroke="${active?'#34d399':(allCastlesPassed()?'#6ee7b7':'#64748b')}" stroke-width="10"/><circle cx="60" cy="55" r="12" fill="${active?'#34d399':(allCastlesPassed()?'#047857':'#334155')}"/><rect x="55" y="83" width="10" height="60" fill="${active?'#34d399':(allCastlesPassed()?'#047857':'#475569')}"/><rect x="55" y="120" width="22" height="8" fill="${active?'#34d399':(allCastlesPassed()?'#047857':'#475569')}"/><rect x="55" y="133" width="16" height="8" fill="${active?'#34d399':(allCastlesPassed()?'#047857':'#475569')}"/></svg><div class="temple-label"><span class="num">LLAVE ${pct}%</span>${active?'✓ ACTIVA':(allCastlesPassed()?'La Llave':'Bloqueada')}</div>`;
            el.addEventListener('click',()=>{if(!allCastlesPassed()){showToast('Conquista antes todos los castillos para acceder a la llave.','warn','Llave bloqueada');return;}showView('chiave');});
        }else if(item.kind==='door'){
            const active=keyActive();const passed=certExamPassed();
            el.style.setProperty('--m-scale','1.25');el.classList.add(passed?'complete':(active?'open':'locked'));el.style.setProperty('--glow','28px');
            el.innerHTML=medievalDoorSVG(passed,active,'D')+`<div class="temple-label"><span class="num">PUERTA</span>${passed?'Certificado':(active?'Certificación':'Bloqueada')}</div>`;
            el.addEventListener('click',()=>showView('certificazione'));
        }
        container.appendChild(el);
    });
    const d=pts.map((p,i)=>(i===0?'M ':'L ')+p[0].toFixed(2)+' '+p[1].toFixed(2)).join(' ');
    $('castleMapPath').setAttribute('d',d);positionCastleOwl();updateCastleHeaderProgress();
}
function positionCastleOwl(){
    const container=$('castleMapContainer');const owl=$('castleOwl');const items=getCastleOrderedMarkers();
    let idx=items.findIndex(it=>it.kind==='castle'&&!isCastlePassed(it.castle.id));
    if(idx===-1)idx=items.findIndex(it=>it.kind==='key');
    if(idx===-1||keyActive())idx=items.findIndex(it=>it.kind==='door');
    if(idx===-1)idx=items.length-1;
    const item=items[idx];let markerIdx=idx;
    if(item&&item.kind==='castle'&&!isCastleUnlocked(item.castle)&&!isCastlePassed(item.castle.id)){const tIdx=items.findIndex(it=>it.kind==='temple'&&it.temple.id===item.castle.templeId);if(tIdx>=0)markerIdx=tIdx;}
    const markers=container.querySelectorAll('.temple-marker');const target=markers[markerIdx];if(!target)return;
