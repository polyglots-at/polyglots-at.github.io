/* ============ EXERCISE TYPES ============ */
const PRACTICE_TYPES=[
{id:"translate_es",name:"Traduce PT→ES",icon:"🔤"},{id:"translate_en",name:"Traduce ES→PT",icon:"🔠"},
{id:"fill_blank",name:"Completa",icon:"✏️"},{id:"order_words",name:"Ordena",icon:"🔀"},
{id:"listen",name:"Escucha PT",icon:"🎧"},{id:"listen_es",name:"Escucha→ES",icon:"🎶"},
{id:"spell",name:"Escribe",icon:"⌨️"},{id:"true_false",name:"Verdadero/Falso",icon:"⚖️"},
{id:"pronounce",name:"Pronuncia",icon:"🎤"},{id:"questions",name:"Preguntas",icon:"❓"}
];
function generateExercises(type,phrases){
    switch(type){
        case 'translate_es':return shuffle(genTranslateES(phrases));
        case 'translate_en':return shuffle(genTranslateEN(phrases));
        case 'fill_blank':return shuffle(genFillBlank(phrases));
        case 'order_words':return shuffle(genOrderWords(phrases));
        case 'listen':return shuffle(genListen(phrases));
        case 'listen_es':return shuffle(genListenES(phrases));
        case 'spell':return shuffle(genSpell(phrases));
        case 'true_false':return shuffle(genTrueFalse(phrases));
        case 'pronounce':return shuffle(genPronounce(phrases));
        case 'questions':return shuffle(genQuestions(phrases));
        case 'mixed':return genMixed(phrases);
        default:return [];
    }
}
function genTranslateES(ps){return ps.map(p=>{const d=shuffle(ps.filter(x=>x.es!==p.es).map(x=>x.es)).slice(0,3);return{type:'translate_es',question:'¿Qué significa en español?',prompt:p.en,promptSp:p.sp,options:shuffle([p.es,...d]),correct:p.es,explanation:`"${p.en}" significa "${p.es}"`};});}
function genTranslateEN(ps){return ps.map(p=>{const d=shuffle(ps.filter(x=>x.en!==p.en).map(x=>x.en)).slice(0,3);return{type:'translate_en',question:'¿Cómo se dice en portugués?',prompt:p.es,options:shuffle([p.en,...d]),correct:p.en,explanation:`"${p.es}" se dice "${p.en}"`};});}
function genFillBlank(ps){return ps.map(p=>{const ws=p.en.split(/\s+/);if(ws.length<2)return null;const idx=1+Math.floor(Math.random()*(ws.length-1));const word=ws[idx].replace(/[.,!?;:'"«»]+$/,'').replace(/^[.,!?;:'"«»]+/,'');const blanked=ws.map((w,i)=>i===idx?'___':w).join(' ');return{type:'fill_blank',question:'Escribe la palabra que falta:',prompt:blanked,hint:p.es,correct:word,explanation:`Frase completa: "${p.en}"`};}).filter(Boolean);}
function genOrderWords(ps){return ps.map(p=>{const ws=p.en.split(/\s+/);if(ws.length<3)return null;let sh=shuffle([...ws]);if(sh.join(' ')===ws.join(' '))[sh[0],sh[1]]=[sh[1],sh[0]];return{type:'order_words',question:'Ordena las palabras:',prompt:p.es,words:sh,correct:p.en,explanation:`La frase correcta es: "${p.en}"`};}).filter(Boolean);}
function genListen(ps){return ps.map(p=>{const d=shuffle(ps.filter(x=>x.en!==p.en).map(x=>x.en)).slice(0,3);return{type:'listen',question:'Escucha y elige la frase que has oído:',audio:cleanForSpeech(p.en),options:shuffle([p.en,...d]),correct:p.en,explanation:`Has oído: "${p.en}" — ${p.es}`};});}
function genListenES(ps){return ps.map(p=>{const d=shuffle(ps.filter(x=>x.es!==p.es).map(x=>x.es)).slice(0,3);return{type:'listen_es',question:'Escucha y elige el significado:',audio:cleanForSpeech(p.en),options:shuffle([p.es,...d]),correct:p.es,explanation:`"${p.en}" = "${p.es}"`};});}
function genSpell(ps){return ps.map(p=>({type:'spell',question:'Escucha y escribe la frase en portugués:',audio:cleanForSpeech(p.en),hint:p.es,correct:p.en,explanation:`La frase era: "${p.en}"`}));}
function genTrueFalse(ps){return ps.map(p=>{const isTrue=Math.random()<0.5;const others=ps.filter(x=>x.es!==p.es);const fakeEs=others.length?others[Math.floor(Math.random()*others.length)].es:p.es+' (?)';const claim=isTrue?p.es:fakeEs;return{type:'true_false',question:'¿La traducción es correcta?',prompt:p.en,claim,options:['Verdadero','Falso'],correct:isTrue?'Verdadero':'Falso',explanation:isTrue?`"${p.en}" = "${p.es}"`:`"${p.en}" NO significa "${claim}", significa "${p.es}"`};});}
function genPronounce(ps){return ps.map(p=>({type:'pronounce',question:'Pronuncia esta frase en voz alta:',target:p.en,targetSp:p.sp,meaning:p.es}));}
function genQuestions(ps){const qs=[];ps.forEach(p=>{const d1=shuffle(ps.filter(x=>x.es!==p.es).map(x=>x.es)).slice(0,3);qs.push({type:'question',question:`¿Qué significa "${p.en}" en español?`,options:shuffle([p.es,...d1]),correct:p.es,explanation:`"${p.en}" = "${p.es}"`});const d2=shuffle(ps.filter(x=>x.en!==p.en).map(x=>x.en)).slice(0,3);qs.push({type:'question',question:`¿Cómo se dice "${p.es}" en portugués?`,options:shuffle([p.en,...d2]),correct:p.en,explanation:`"${p.es}" = "${p.en}"`});});return qs;}
function genMixed(ps){return shuffle([...shuffle(genTranslateES(ps)).slice(0,2),...shuffle(genTranslateEN(ps)).slice(0,2),...shuffle(genFillBlank(ps)).slice(0,2),...shuffle(genOrderWords(ps)).slice(0,2),...shuffle(genListen(ps)).slice(0,1),...shuffle(genListenES(ps)).slice(0,1),...shuffle(genSpell(ps)).slice(0,1),...shuffle(genTrueFalse(ps)).slice(0,2),...shuffle(genPronounce(ps)).slice(0,1),...shuffle(genQuestions(ps)).slice(0,1)]);}

function renderExerciseInto(containerId,ex,session,nextBtnId){
    const c=$(containerId);const s=session;const nextBtn=$(nextBtnId);
    const finishEx=()=>{s.currentIndex++;if(s===castleSession)renderCastleExercise();else if(s===citySession)renderCityExercise();else if(s===llaveSession)renderLlaveExercise();else if(s===certExamSession)renderCertExam();};
    const updateScore=()=>{if(s===castleSession)$('castleExScore').textContent=`✓ ${s.score}`;if(s===citySession)$('cityExScore').textContent=`✓ ${s.score}`;if(s===llaveSession)$('llaveExScore').textContent=`✓ ${s.score}`;if(s===certExamSession)$('certExScore').textContent=`✓ ${s.score}`;};
    const showFb=(isCorrect,extra)=>{const fb=$('feedback');if(!fb)return;fb.innerHTML=`<div class="feedback-box ${isCorrect?'correct':'incorrect'}"><p style="font-weight:600;margin-bottom:2px">${isCorrect?'✓ ¡Correcto!':'✗ Incorrecto'}</p><p style="font-size:.85rem">${escHtml(ex.explanation||'')}</p>${extra?`<p style="font-size:.75rem;opacity:.8;margin-top:2px">${extra}</p>`:''}</div>`;};
    if(['translate_es','translate_en','question','true_false','listen','listen_es'].includes(ex.type)){
        c.innerHTML=`<div class="exercise-container"><div class="exercise-question">${escHtml(ex.question)}</div>${ex.prompt?`<div class="exercise-prompt">${escHtml(ex.prompt)}${ex.promptSp?` <span class="phon">[${escHtml(ex.promptSp)}]</span>`:''}</div>`:''}${ex.audio?`<div style="text-align:center;margin-bottom:14px"><button class="speak-btn" style="width:52px;height:52px;font-size:1.4rem" onclick="speak('${escAttr(ex.audio)}',this)">🔊</button></div>`:''}${ex.claim?`<div style="text-align:center;margin-bottom:12px;font-style:italic;color:#34d399;font-size:1.05rem">"${escHtml(ex.claim)}"</div>`:''}<div id="optionsWrap"></div><div id="feedback"></div></div>`;
        const wrap=$('optionsWrap');
        ex.options.forEach(opt=>{
            const btn=document.createElement('button');btn.className='opt-btn';btn.textContent=opt;
            btn.onclick=()=>{
                const isCorrect=opt===ex.correct;
                if(isCorrect)s.score++;
                wrap.querySelectorAll('.opt-btn').forEach(b=>b.disabled=true);
                btn.classList.add(isCorrect?'correct':'incorrect');
                if(!isCorrect)wrap.querySelectorAll('.opt-btn').forEach(b=>{if(b.textContent===ex.correct)b.classList.add('correct');});
                isCorrect?playCorrectSound():playWrongSound();
                showFb(isCorrect);updateScore();nextBtn.classList.add('visible');
            };
            wrap.appendChild(btn);
        });
        nextBtn.onclick=finishEx;
    } else if(ex.type==='fill_blank'||ex.type==='spell'){
        c.innerHTML=`<div class="exercise-container"><div class="exercise-question">${escHtml(ex.question)}</div>${ex.audio?`<div style="text-align:center;margin-bottom:14px"><button class="speak-btn" style="width:52px;height:52px;font-size:1.4rem" onclick="speak('${escAttr(ex.audio)}',this)">🔊</button></div>`:''}${ex.prompt?`<div class="exercise-prompt">${escHtml(ex.prompt)}</div>`:''}${ex.hint?`<div style="text-align:center;font-size:.85rem;color:#a8b8a8;margin-bottom:10px">💡 ${escHtml(ex.hint)}</div>`:''}<input type="text" class="text-input" id="textAnswer" placeholder="Escribe aquí..." autocomplete="off" autocorrect="off" spellcheck="false"><button class="check-btn" id="checkBtn">Verificar</button><div id="feedback"></div></div>`;
        const inp=$('textAnswer'),chk=$('checkBtn');
        chk.onclick=()=>{const val=inp.value.trim();if(!val)return;const isCorrect=normText(val)===normText(ex.correct);if(isCorrect)s.score++;inp.disabled=true;chk.disabled=true;inp.style.borderColor=isCorrect?'#22c55e':'#ef4444';isCorrect?playCorrectSound():playWrongSound();showFb(isCorrect,`Respuesta correcta: "${escHtml(ex.correct)}"`);updateScore();nextBtn.classList.add('visible');};
        inp.addEventListener('keydown',e=>{if(e.key==='Enter')chk.click();});
        nextBtn.onclick=finishEx;
    } else if(ex.type==='order_words'){
        c.innerHTML=`<div class="exercise-container"><div class="exercise-question">${escHtml(ex.question)}</div><div class="exercise-prompt" style="font-size:.95rem;color:#a8b8a8">Traducción: "${escHtml(ex.prompt)}"</div><div id="wordBank" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px;justify-content:center"></div><div id="sentenceBuilder" style="min-height:56px;background:rgba(0,0,0,.3);border-radius:12px;padding:12px;margin-bottom:14px;display:flex;flex-wrap:wrap;gap:8px;border:1px dashed rgba(52,211,153,.4)"></div><button class="check-btn" id="checkBtn" style="display:block;margin:0 auto">Verificar</button><div id="feedback"></div></div>`;
        const bank=$('wordBank'),builder=$('sentenceBuilder');
        ex.words.forEach((w)=>{
            const b=document.createElement('button');b.className='opt-btn';b.style.cssText='width:auto;margin:0;padding:8px 14px;font-size:.95rem';b.textContent=w;
            b.onclick=()=>{if(b.disabled)return;b.disabled=true;b.style.opacity='.35';const c2=document.createElement('button');c2.className='opt-btn';c2.style.cssText='width:auto;margin:0;padding:8px 14px;font-size:.95rem';c2.textContent=w;c2.onclick=()=>{c2.remove();b.disabled=false;b.style.opacity='1';};builder.appendChild(c2);};
            bank.appendChild(b);
        });
        $('checkBtn').onclick=()=>{
            const built=[...builder.querySelectorAll('button')].map(b=>b.textContent).join(' ');
            if(!built)return;
            const isCorrect=normText(built)===normText(ex.correct);
            if(isCorrect)s.score++;
            $('checkBtn').disabled=true;bank.querySelectorAll('button').forEach(b=>b.disabled=true);builder.querySelectorAll('button').forEach(b=>b.disabled=true);
            isCorrect?playCorrectSound():playWrongSound();
            showFb(isCorrect,`Frase correcta: "${escHtml(ex.correct)}"`);
            updateScore();nextBtn.classList.add('visible');
        };
        nextBtn.onclick=finishEx;
    } else if(ex.type==='pronounce'){
        c.innerHTML=`<div class="exercise-container"><div class="exercise-question">${escHtml(ex.question)}</div><div class="exercise-prompt">${escHtml(ex.target)}${ex.targetSp?`<span class="phon">[${escHtml(ex.targetSp)}]</span>`:''}</div><div style="text-align:center;color:#a8b8a8;font-size:.88rem;margin-bottom:14px">${escHtml(ex.meaning||'')}</div><div style="text-align:center;margin-bottom:14px"><button class="speak-btn" style="width:52px;height:52px;font-size:1.4rem" onclick="speak('${escAttr(cleanForSpeech(ex.target))}',this)">🔊</button></div><div style="text-align:center;color:#a8b8a8;font-size:.85rem;margin-bottom:16px">Repite en voz alta y luego pulsa el botón</div><button class="check-btn" id="checkBtn" style="display:block;margin:0 auto">✓ Hecho</button></div>`;
        $('checkBtn').onclick=()=>{s.score++;playCorrectSound();updateScore();finishEx();};
    }
}

/* ============ CASTLE EXERCISE ============ */
let castleSession=null;const SESSION_LEN=12;
function startCastleExercise(castleId){
    const c=CASTLES.find(x=>x.id===castleId);if(!c)return;
    if(!isCastleUnlocked(c)&&!isCastlePassed(c.id)){showToast(`Completa primero las lecciones del castillo ${c.number}.`,'warn','Castillo bloqueado');return;}
    const phrases=PHRASES_BY_TEMPLE[c.templeId]||[];const exercises=generateExercises('mixed',phrases).slice(0,SESSION_LEN);
    if(!exercises.length){showToast('No se pudieron generar preguntas.','error');return;}
    castleSession={castleId:c.id,type:'evaluation',exercises,currentIndex:0,score:0};showView('castelli-exercise');renderCastleExercise();
}
function startCastlePractice(templeId,type){
    const phrases=PHRASES_BY_TEMPLE[templeId]||[];const exercises=generateExercises(type,phrases).slice(0,SESSION_LEN);
    if(!exercises.length){showToast('No se pudieron generar ejercicios.','error');return;}
    castleSession={templeId,type,exercises,currentIndex:0,score:0};showView('castelli-exercise');renderCastleExercise();
}
function renderCastleExercise(){
    const s=castleSession;if(!s)return;
    if(s.currentIndex>=s.exercises.length){finishCastleExercise();return;}
    const ex=s.exercises[s.currentIndex];const total=s.exercises.length;
    $('castleExProgressLabel').textContent=`Misión ${s.currentIndex+1} / ${total}`;$('castleExScore').textContent=`✓ ${s.score}`;
    $('castleExProgressBar').style.width=((s.currentIndex/total)*100)+'%';$('castleNextExBtn').classList.remove('visible');
    renderExerciseInto('castleExerciseContainer',ex,s,'castleNextExBtn');
}
function finishCastleExercise(){
    const s=castleSession;if(!s)return;const total=s.exercises.length;const pct=Math.round((s.score/total)*100);
    const stars=pct>=85?3:(pct>=70?2:(pct>=50?1:0));
    document.querySelectorAll('#castleResStars .star').forEach((el,i)=>el.classList.toggle('lit',i<stars));
    if(s.castleId){
        const c=CASTLES.find(x=>x.id===s.castleId);State.castles.castles[s.castleId]=Math.max(castleScore(s.castleId),pct);saveCastles();
        const passed=pct>=70;$('castleResEmoji').textContent=passed?'🏆':'📚';
        $('castleResTitle').textContent=passed?'¡Castillo Conquistado!':'Castillo Resistido';
        $('castleResSubtitle').textContent=`Castillo ${c.number} · Templo ${c.templeId} (${c.templeTitle}) · Etapa ${c.stageIndex+1}`;
        $('castleResScore').textContent=pct+'%';$('castleResDetail').textContent=`${s.score} de ${total} correctas`;
        const st=$('castleResStatus');st.textContent=passed?'✅ SUPERADO':'❌ NO SUPERADO (necesitas 70%)';st.className='status '+(passed?'passed':'failed');
        showView('castelli-results');renderCastleMap();updateCastleHeaderProgress();
    }else{
        $('castleResEmoji').textContent=pct>=85?'🌟':(pct>=70?'🎉':'💪');
        $('castleResTitle').textContent=pct>=85?'¡Excelente!':(pct>=70?'¡Muy bien!':'Buen intento');
        $('castleResSubtitle').textContent=PRACTICE_TYPES.find(p=>p.id===s.type)?.name||'Práctica mixta';
        $('castleResScore').textContent=pct+'%';$('castleResDetail').textContent=`${s.score} de ${total} correctas`;
        $('castleResStatus').textContent='';$('castleResStatus').className='status';showView('castelli-results');
    }
}
function retryCastleExercise(){if(!castleSession)return;if(castleSession.castleId)startCastleExercise(castleSession.castleId);else startCastlePractice(castleSession.templeId,castleSession.type);}
function goBackToCastleKingdom(){if(castleSession){if(castleSession.castleId){const c=CASTLES.find(x=>x.id===castleSession.castleId);if(c){goCastleKingdom(c.templeId);return;}}else{goCastleKingdom(castleSession.templeId);return;}}showView('castelli-map');}
function quitCastleExercise(){goBackToCastleKingdom();}

/* ============ KEY ============ */
let llaveSession=null;
const KEY_ROUNDS=[
{id:'s1',name:'Ronda 1 · Gramática',icon:'📜',desc:'Templos 1-3',temples:[1,2,3]},
{id:'s2',name:'Ronda 2 · Vocabulario',icon:'📚',desc:'Templos 4-6',temples:[4,5,6]},
{id:'s3',name:'Ronda 3 · Práctica',icon:'✏️',desc:'Templos 7-8',temples:[7,8]}
];
function renderLlave(){
    const pct=keyPercent();const active=keyActive();
    $('keyProgressFill').style.width=pct+'%';$('keyProgressText').textContent=`${pct}% · ${keySealsCount()} de 3 sellos`;
    const container=$('keySeals');
    container.innerHTML=KEY_ROUNDS.map((r,i)=>{
        const score=State.castles.key[r.id]||0;const done=score>=70;const hasScore=score>0;
        const prevDone=i===0||(State.castles.key[KEY_ROUNDS[i-1].id]||0)>=70;
        let cls='key-seal';if(done)cls+=' done';else if(hasScore)cls+=' active';else if(!prevDone)cls+=' locked';
        const status=done?`✓ ${score}%`:(hasScore?`${score}% (necesitas 70%)`:(prevDone?'Pendiente':'🔒 Bloqueado'));
        return `<div class="${cls}" data-round="${r.id}"><div class="seal-icon">${r.icon}</div><div class="seal-name">${escHtml(r.name)}</div><div class="seal-status">${status}</div></div>`;
    }).join('');
    container.querySelectorAll('.key-seal').forEach(el=>{
        el.addEventListener('click',()=>{
            const r=KEY_ROUNDS.find(x=>x.id===el.dataset.round);if(!r)return;
            const i=KEY_ROUNDS.indexOf(r);
            if(i>0&&(State.castles.key[KEY_ROUNDS[i-1].id]||0)<70){showToast('Completa primero la ronda anterior','warn');return;}
            startLlaveRound(r);
        });
    });
    const startBtn=$('keyStartBtn');
    if(active){startBtn.style.display='none';return;}
    const nextRound=KEY_ROUNDS.find((r,i)=>(i===0||(State.castles.key[KEY_ROUNDS[i-1].id]||0)>=70)&&(State.castles.key[r.id]||0)<70);
    if(nextRound){startBtn.style.display='';startBtn.textContent=`▶ Empezar ${nextRound.name}`;startBtn.onclick=()=>startLlaveRound(nextRound);}
    else startBtn.style.display='none';
}
function startLlaveRound(round){
    const phrases=[];round.temples.forEach(tid=>{const p=PHRASES_BY_TEMPLE[tid]||[];phrases.push(...p);});
    const exercises=shuffle(generateExercises('mixed',phrases)).slice(0,10);
    if(!exercises.length){showToast('No se pudieron generar preguntas.','error');return;}
    llaveSession={roundId:round.id,roundName:round.name,exercises,currentIndex:0,score:0};
    showView('chiave-exercise');renderLlaveExercise();
}
function renderLlaveExercise(){
    const s=llaveSession;if(!s)return;
    if(s.currentIndex>=s.exercises.length){finishLlaveRound();return;}
    const ex=s.exercises[s.currentIndex];const total=s.exercises.length;
    $('llaveExProgressLabel').textContent=`Pregunta ${s.currentIndex+1} / ${total}`;$('llaveExScore').textContent=`✓ ${s.score}`;
    $('llaveExProgressBar').style.width=((s.currentIndex/total)*100)+'%';$('llaveNextExBtn').classList.remove('visible');
    renderExerciseInto('llaveExerciseContainer',ex,s,'llaveNextExBtn');
}
function finishLlaveRound(){
    const s=llaveSession;if(!s)return;const total=s.exercises.length;const pct=Math.round((s.score/total)*100);
    State.castles.key[s.roundId]=Math.max(State.castles.key[s.roundId]||0,pct);saveCastles();
    const passed=pct>=70;const stars=pct>=85?3:(pct>=70?2:(pct>=50?1:0));
    document.querySelectorAll('#llaveResStars .star').forEach((el,i)=>el.classList.toggle('lit',i<stars));
    $('llaveResEmoji').textContent=passed?'🔑':'🔒';
    $('llaveResTitle').textContent=passed?'¡Sello obtenido!':'Sello no obtenido';
    $('llaveResSubtitle').textContent=s.roundName;$('llaveResScore').textContent=pct+'%';
    $('llaveResDetail').textContent=`${s.score} de ${total} correctas`;
    const st=$('llaveResStatus');
    if(passed){st.textContent=keyActive()?'✨ ¡LLAVE COMPLETADA! La puerta se ha abierto.':'✅ Sello obtenido';st.className='status passed';}
    else{st.textContent='❌ Necesitas al menos el 70%';st.className='status failed';}
    showView('chiave-results');renderCastleMap();
}
function retryLlaveExercise(){if(!llaveSession)return;const r=KEY_ROUNDS.find(x=>x.id===llaveSession.roundId);if(r)startLlaveRound(r);}
function quitLlaveExercise(){showView('chiave');}

/* ============ CERTIFICACIÓN ============ */
function renderCertificazione(){
    const active=keyActive();const allCastles=allCastlesPassed();const examPass=certExamPassed();
    const reqs=[
        {ok:allCastles,icon:'🏰',label:'Castillos conquistados',status:allCastles?'✓ Completado':'Pendiente'},
        {ok:active,icon:'🔑',label:'Llave de la Certificación',status:active?'✓ Activa':`${keyPercent()}%`},
        {ok:examPass,icon:'🎓',label:'Examen de certificación',status:examPass?`✓ ${State.castles.key.exam}%`:'Pendiente'}
    ];
    $('certRequirements').innerHTML=reqs.map(r=>`<div class="cert-req ${r.ok?'ok':''}"><div class="req-icon">${r.icon}</div><div class="req-label">${escHtml(r.label)}</div><div class="req-status">${r.status}</div></div>`).join('');
    const doorStatus=$('certDoorStatus');const doorIcon=$('certDoorIcon');
    if(examPass){doorIcon.textContent='🎓';doorIcon.classList.remove('locked');doorStatus.innerHTML=`<div class="door-status ok">✓ ¡Certificación completada! Puedes ver tu certificado.</div>`;}
    else if(active&&allCastles){doorIcon.textContent='🚪';doorIcon.classList.remove('locked');doorStatus.innerHTML=`<div class="door-status ok">✓ ¡La puerta está abierta! Puedes hacer el examen.</div>`;}
    else if(active){doorIcon.textContent='🚪';doorIcon.classList.remove('locked');doorStatus.innerHTML=`<div class="door-status pending">⚠ La llave está activa, pero faltan castillos.</div>`;}
    else{doorIcon.textContent='🚪';doorIcon.classList.add('locked');doorStatus.innerHTML=`<div class="door-status blocked">🔒 La puerta está bloqueada. Obtén la Llave de la Certificación y conquista todos los castillos.</div>`;}
    const area=$('certActionArea');
    if(examPass)area.innerHTML=`<button class="play-btn" onclick="renderCertificado()">🎓 Ver mi certificado</button>`;
    else if(active&&allCastles)area.innerHTML=`<button class="play-btn" onclick="startCertExam()">🎓 Empezar examen de certificación</button>`;
    else if(!active)area.innerHTML=`<button class="play-btn" onclick="${allCastles?"showView('chiave')":"showView('castelli-map')"}">${allCastles?'🔑 Ir a la llave':'🏰 Volver al mapa'}</button>`;
}
let certExamSession=null;const CERT_EXAM_LEN=20;
function startCertExam(){
    if(!keyActive()||!allCastlesPassed()){showToast('Necesitas la llave activa y todos los castillos.','warn','Requisitos incompletos');return;}
    const allPhrases=[];Object.values(PHRASES_BY_TEMPLE).forEach(arr=>allPhrases.push(...arr));
    const exercises=shuffle(generateExercises('mixed',allPhrases)).slice(0,CERT_EXAM_LEN);
    if(!exercises.length){showToast('No se pudieron generar preguntas.','error');return;}
    certExamSession={exercises,currentIndex:0,score:0};showView('cert-exam');renderCertExam();
}
function renderCertExam(){
    const s=certExamSession;if(!s)return;
    if(s.currentIndex>=s.exercises.length){finishCertExam();return;}
    const ex=s.exercises[s.currentIndex];const total=s.exercises.length;
    $('certExProgressLabel').textContent=`Pregunta ${s.currentIndex+1} / ${total}`;$('certExScore').textContent=`✓ ${s.score}`;
    $('certExProgressBar').style.width=((s.currentIndex/total)*100)+'%';$('certNextExBtn').classList.remove('visible');
    renderExerciseInto('certExamContainer',ex,s,'certNextExBtn');
}
function finishCertExam(){
    const s=certExamSession;if(!s)return;const total=s.exercises.length;const pct=Math.round((s.score/total)*100);
    State.castles.key.exam=Math.max(State.castles.key.exam||0,pct);saveCastles();
    const passed=pct>=70;const stars=pct>=85?3:(pct>=70?2:(pct>=50?1:0));
    document.querySelectorAll('#certResStars .star').forEach((el,i)=>el.classList.toggle('lit',i<stars));
    $('certResEmoji').textContent=passed?'🎓':'📚';
    $('certResTitle').textContent=passed?'¡Certificación Superada!':'Certificación no superada';
    $('certResSubtitle').textContent='Examen final del Curso Básico de Portugués';
    $('certResScore').textContent=pct+'%';$('certResDetail').textContent=`${s.score} de ${total} correctas`;
    const st=$('certResStatus');st.textContent=passed?'✅ SUPERADO · Puedes solicitar el certificado':'❌ Necesitas el 70% para superar';st.className='status '+(passed?'passed':'failed');
    const actions=$('certResActions');
    if(passed)actions.innerHTML=`<button class="btn-primary" onclick="renderCertificado()">🎓 Ver mi certificado</button><button class="btn-secondary" onclick="startCertExam()">🔁 Repetir</button><button class="btn-secondary" onclick="goDashboard()">🏠 Inicio</button>`;
    else actions.innerHTML=`<button class="btn-primary" onclick="startCertExam()">🔁 Reintentar</button><button class="btn-secondary" onclick="showView('certificazione')">← Volver</button><button class="btn-secondary" onclick="goDashboard()">🏠 Inicio</button>`;
    showView('cert-results');
}
function quitCertExam(){showView('certificazione');}

/* ============ CERTIFICADO ============ */
function renderCertificado(){
    $('certNameInput').value=State.castles.certName||'';
    $('certScore').textContent=(State.castles.key.exam||0)+'%';
    const today=new Date();const months=['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
    $('certDate').textContent=`Emitido el ${today.getDate()} de ${months[today.getMonth()]} de ${today.getFullYear()}`;
    updateCertEmail();
    $('certNameInput').oninput=function(){State.castles.certName=this.value;saveCastles();updateCertEmail();};
    showView('certificato');
}
function updateCertEmail(){
    const name=State.castles.certName||'[Escribe tu nombre]';
    const score=State.castles.key.exam||0;
    const today=new Date();const dateStr=`${today.getDate()}/${today.getMonth()+1}/${today.getFullYear()}`;
    const subject='SOLICITUD CERTIFICADO';
