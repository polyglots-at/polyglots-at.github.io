.toast .toast-text{flex:1;line-height:1.35}
.toast.out{animation:toastOut .3s ease forwards}
@keyframes toastIn{0%{opacity:0;transform:translateY(-14px) scale(.96)}100%{opacity:1;transform:translateY(0) scale(1)}}
@keyframes toastOut{0%{opacity:1;transform:translateY(0) scale(1)}100%{opacity:0;transform:translateY(-10px) scale(.97)}}
