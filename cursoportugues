/* ============ CITY MODULE ============ */
let citySession=null;let cityCurrentPlace=null;
function renderCityMap(){
    const container=$('cityMapContainer');container.querySelectorAll('.place-marker').forEach(el=>el.remove());
    const items=CITY_PLACES;const isMobile=window.innerWidth<=640;const cols=isMobile?2:4;const rows=Math.ceil(items.length/cols);const rowH=isMobile?205:240;
    container.style.height=(rows*rowH)+'px';const pts=[];
    items.forEach((p,i)=>{
        const row=Math.floor(i/cols);let col=i%cols;if(row%2===1)col=cols-1-col;
        const xPct=((col+0.5)/cols)*100;const yPct=((row+0.5)/rows)*100;pts.push([xPct,yPct]);
        const el=document.createElement('div');el.className='place-marker';el.style.left=xPct+'%';el.style.top=yPct+'%';
        const passed=(State.city.scores[p.id]||0)>=70;
        el.style.setProperty('--m-scale','1');el.style.setProperty('--glow','20px');
        if(passed)el.classList.add('passed');
        const gradId='pGrad'+i;
        const ringCol=passed?'#fbbf24':'#94b8a3';
        const fillCol=passed?'rgba(251,191,36,0.28)':'rgba(255,255,255,0.06)';
        el.innerHTML=`<svg class="place-svg" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg"><defs><radialGradient id="${gradId}"><stop offset="0" stop-color="#fde68a" stop-opacity="0.9"/><stop offset="1" stop-color="#fbbf24" stop-opacity="0.1"/></radialGradient></defs>${passed?`<circle cx="60" cy="52" r="42" fill="url(#${gradId})" opacity="0.4"/>`:''}<circle cx="60" cy="52" r="34" fill="${fillCol}" stroke="${ringCol}" stroke-width="2.5"/><circle cx="60" cy="52" r="28" fill="none" stroke="${ringCol}" stroke-width="0.8" opacity="0.6"/><text x="60" y="64" text-anchor="middle" font-size="30">${p.icon}</text><circle cx="86" cy="28" r="4" fill="${passed?'#fcd34d':'#64748b'}" stroke="#0f172a" stroke-width="1"/><text x="60" y="104" text-anchor="middle" font-size="9" fill="#f0fff5" font-family="sans-serif" font-weight="700">${escHtml(p.name)}</text><text x="60" y="115" text-anchor="middle" font-size="7" fill="#94b8a3" font-family="sans-serif">${escHtml(p.city)}</text></svg><div class="place-label"><span class="num">${passed?'✓ VISITADO':'DISPONIBLE'}</span></div>`;
        el.addEventListener('click',()=>openCityPlace(p.id));
        container.appendChild(el);
    });
    const d=pts.map((p,i)=>(i===0?'M ':'L ')+p[0].toFixed(2)+' '+p[1].toFixed(2)).join(' ');
    $('cityMapPath').setAttribute('d',d);positionCityOwl();updateCityHeaderProgress();
}
function positionCityOwl(){
    const container=$('cityMapContainer');const owl=$('cityOwl');
    let idx=CITY_PLACES.findIndex(p=>(State.city.scores[p.id]||0)<70);
    if(idx===-1)idx=CITY_PLACES.length-1;
    const markers=container.querySelectorAll('.place-marker');const target=markers[idx];if(!target)return;
    requestAnimationFrame(()=>{const cr=container.getBoundingClientRect();const r=target.getBoundingClientRect();if(!cr.width||!cr.height)return;owl.style.left=(((r.left+r.width/2)-cr.left)/cr.width*100)+'%';owl.style.top=((r.top-cr.top)/cr.height*100)+'%';});
}
function updateCityHeaderProgress(){const s=cityProgressStats();if($('cityHeaderProgress'))$('cityHeaderProgress').textContent=s.percent+'%';if($('cityHeaderBar'))$('cityHeaderBar').style.width=s.percent+'%';}
function openCityPlace(placeId){
    const p=CITY_PLACES.find(x=>x.id===placeId);if(!p)return;
    cityCurrentPlace=placeId;
    $('cityPlaceHeader').innerHTML=`<h2>${p.icon} ${escHtml(p.name)} · ${escHtml(p.city)}</h2><p>${escHtml(p.desc)}</p><p style="margin-top:8px;font-size:.8rem;color:#fbbf24">${p.phrases.length} frases</p>`;
    $('cityVocabGrid').innerHTML=p.phrases.map(ph=>`<div class="vocab-card" data-en="${escAttr(ph.en)}"><div class="vc-body"><div class="vc-en">${escHtml(ph.en)}</div><div class="vc-phon">[${escHtml(ph.sp)}]</div><div class="vc-es">${escHtml(ph.es)}</div></div><span class="vc-speak">🔊</span></div>`).join('');
    document.querySelectorAll('#cityVocabGrid .vocab-card').forEach(card=>{card.addEventListener('click',()=>speak(card.dataset.en,card.querySelector('.vc-speak')));});
    $('cityPracticeGrid').innerHTML=PRACTICE_TYPES.map(pt=>`<div class="lesson-card" onclick="startCityPractice('${p.id}','${pt.id}')"><span class="icon">${pt.icon}</span><span class="name">${escHtml(pt.name)}</span></div>`).join('');
    $('cityPlayBtn').onclick=()=>startCityPractice(p.id,'mixed');
    $('cityEvalBtn').onclick=()=>startCityEvaluation(p.id);
    showView('citta-place');
}
function startCityPractice(placeId,type){
    const p=CITY_PLACES.find(x=>x.id===placeId);if(!p)return;
    const exercises=generateExercises(type,p.phrases).slice(0,10);
    if(!exercises.length){showToast('No se pudieron generar ejercicios.','error');return;}
    citySession={placeId,type,exercises,currentIndex:0,score:0,mode:'practice'};showView('citta-exercise');renderCityExercise();
}
function startCityEvaluation(placeId){
    const p=CITY_PLACES.find(x=>x.id===placeId);if(!p)return;
    const exercises=generateExercises('mixed',p.phrases).slice(0,10);
    if(!exercises.length){showToast('No se pudieron generar preguntas.','error');return;}
    citySession={placeId,type:'evaluation',exercises,currentIndex:0,score:0,mode:'evaluation'};showView('citta-exercise');renderCityExercise();
}
function renderCityExercise(){
    const s=citySession;if(!s)return;
    if(s.currentIndex>=s.exercises.length){finishCityExercise();return;}
    const ex=s.exercises[s.currentIndex];const total=s.exercises.length;
    $('cityExProgressLabel').textContent=`Misión ${s.currentIndex+1} / ${total}`;$('cityExScore').textContent=`✓ ${s.score}`;
    $('cityExProgressBar').style.width=((s.currentIndex/total)*100)+'%';$('cityNextExBtn').classList.remove('visible');
    renderExerciseInto('cityExerciseContainer',ex,s,'cityNextExBtn');
}
function finishCityExercise(){
    const s=citySession;if(!s)return;const total=s.exercises.length;const pct=Math.round((s.score/total)*100);
    const stars=pct>=85?3:(pct>=70?2:(pct>=50?1:0));
    document.querySelectorAll('#cityResStars .star').forEach((el,i)=>el.classList.toggle('lit',i<stars));
    const p=CITY_PLACES.find(x=>x.id===s.placeId);
    if(s.mode==='evaluation'){
        State.city.scores[s.placeId]=Math.max(State.city.scores[s.placeId]||0,pct);saveCity();
        const passed=pct>=70;
        $('cityResEmoji').textContent=passed?'🏆':'📚';
        $('cityResTitle').textContent=passed?'¡Lugar conquistado!':'Lugar resistido';
        $('cityResSubtitle').textContent=`${p.icon} ${p.name} · ${p.city}`;
        $('cityResScore').textContent=pct+'%';$('cityResDetail').textContent=`${s.score} de ${total} correctas`;
        const st=$('cityResStatus');st.textContent=passed?'✅ SUPERADO':'❌ NO SUPERADO (necesitas 70%)';st.className='status '+(passed?'passed':'failed');
        showView('citta-results');renderCityMap();
    }else{
        $('cityResEmoji').textContent=pct>=85?'🌟':(pct>=70?'🎉':'💪');
        $('cityResTitle').textContent=pct>=85?'¡Excelente!':(pct>=70?'¡Muy bien!':'Buen intento');
        $('cityResSubtitle').textContent=PRACTICE_TYPES.find(pt=>pt.id===s.type)?.name||'Práctica mixta';
        $('cityResScore').textContent=pct+'%';$('cityResDetail').textContent=`${s.score} de ${total} correctas`;
        $('cityResStatus').textContent='';$('cityResStatus').className='status';showView('citta-results');
    }
}
function retryCityExercise(){if(!citySession)return;if(citySession.mode==='evaluation')startCityEvaluation(citySession.placeId);else startCityPractice(citySession.placeId,citySession.type);}
function goBackToCityPlace(){if(citySession&&citySession.placeId)openCityPlace(citySession.placeId);else showView('citta-map');}
function quitCityExercise(){goBackToCityPlace();}

