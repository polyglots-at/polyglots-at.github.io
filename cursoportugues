/* ============ HELPERS ============ */
function castleLessonKey(tid,idx){return 't'+tid+'l'+idx;}
function isCastleLessonDone(tid,idx){return !!State.castles.lessons[castleLessonKey(tid,idx)];}
function markCastleLessonDone(tid,idx){State.castles.lessons[castleLessonKey(tid,idx)]=true;saveCastles();}
function castleScore(id){return State.castles.castles[id]||0;}
function isCastlePassed(id){return castleScore(id)>=70;}
function isCastleUnlocked(c){if(c.number>1&&!isCastlePassed(CASTLES[c.number-2].id))return false;return c.lessonIdx.every(i=>isCastleLessonDone(c.templeId,i));}
function isTempleUnlocked(t){if(t.id===1)return true;const prev=TEMPLES[t.id-2];const last=prev.stages[prev.stages.length-1];return isCastlePassed(last.id);}

/* ============ PROGRESS ============ */
function castleProgressStats(){
    const lessonsDone=Object.keys(State.castles.lessons||{}).filter(k=>State.castles.lessons[k]).length;
    const castlesPassed=Object.values(State.castles.castles||{}).filter(v=>v>=70).length;
    const totalLessons=TEMPLES.reduce((a,t)=>a+t.lessons.length,0);
    const totalCastles=CASTLES.length;
    const total=totalLessons+totalCastles;
    return {done:lessonsDone+castlesPassed,total,percent:Math.round(((lessonsDone+castlesPassed)/total)*100),lessonsDone,castlesPassed};
}
function cityProgressStats(){const passed=Object.values(State.city.scores||{}).filter(v=>v>=70).length;return {done:passed,total:12,percent:Math.round((passed/12)*100)};}
function personasProgressStats(){const done=Object.keys(State.personas.chars||{}).length;return {done,total:14,percent:Math.round((done/14)*100)};}
function keySealsCount(){const k=State.castles.key;let n=0;if(k.s1>=70)n++;if(k.s2>=70)n++;if(k.s3>=70)n++;return n;}
function keyPercent(){return Math.round((keySealsCount()/3)*100);}
function keyActive(){return keySealsCount()===3;}
function certExamPassed(){return (State.castles.key.exam||0)>=70;}
function allCastlesPassed(){return CASTLES.every(c=>isCastlePassed(c.id));}
function getTotalPercent(){
    const c=castleProgressStats(),ci=cityProgressStats(),p=personasProgressStats();
    const total=c.total+ci.total+p.total+3+1;
    const done=c.done+ci.done+p.done+keySealsCount()+(certExamPassed()?1:0);
    return Math.round((done/total)*100);
}
const LEVELS=[{min:0,name:'Novato',icon:'🐣',color:'#94b8a3',glow:'rgba(148,184,163,0.4)'},{min:10,name:'Aprendiz',icon:'📖',color:'#6ee7b7',glow:'rgba(110,231,183,0.5)'},{min:20,name:'Estudiante',icon:'✏️',color:'#34d399',glow:'rgba(52,211,153,0.5)'},{min:30,name:'Practicante',icon:'🔧',color:'#10b981',glow:'rgba(16,185,129,0.5)'},{min:40,name:'Explorador',icon:'🧭',color:'#fbbf24',glow:'rgba(251,191,36,0.5)'},{min:50,name:'Viajero',icon:'✈️',color:'#f59e0b',glow:'rgba(245,158,11,0.5)'},{min:60,name:'Hablante',icon:'🗣️',color:'#f97316',glow:'rgba(249,115,22,0.5)'},{min:70,name:'Conversador',icon:'💬',color:'#f43f5e',glow:'rgba(244,63,94,0.5)'},{min:80,name:'Avanzado',icon:'⭐',color:'#fcd34d',glow:'rgba(252,211,77,0.55)'},{min:90,name:'Maestro',icon:'👑',color:'#fde68a',glow:'rgba(253,230,138,0.6)'},{min:100,name:'Leyenda',icon:'🏆',color:'#ffd700',glow:'rgba(255,215,0,0.7)'}];
function getLevel(percent){let idx=0;for(let i=0;i<LEVELS.length;i++)if(percent>=LEVELS[i].min)idx=i;const cur=LEVELS[idx],next=LEVELS[idx+1]||null;return {index:idx+1,name:cur.name,icon:cur.icon,color:cur.color,glow:cur.glow,next,nextAt:next?next.min:null};}

