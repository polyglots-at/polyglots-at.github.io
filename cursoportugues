function renderDashboard(){
    const totalPercent=getTotalPercent();const level=getLevel(totalPercent);
    $('heroName').textContent=`¡Hola, ${level.name}! ${level.icon}`;
    const badge=$('levelBadge');badge.style.setProperty('--level-color',level.color);badge.style.setProperty('--level-glow',level.glow);
    $('lvIcon').textContent=level.icon;$('lvNum').textContent=`Nivel ${level.index}`;$('lvName').textContent=level.name;
    const circ=2*Math.PI*75;const rf=$('ringFill');rf.style.strokeDasharray=circ;void rf.getBoundingClientRect();rf.style.strokeDashoffset=circ*(1-totalPercent/100);$('ringPercent').textContent=totalPercent+'%';
    const sub=$('heroSub');
    if(level.next)sub.innerHTML=`Te faltan <strong>${level.nextAt-totalPercent}%</strong> para ser <strong>${level.next.name}</strong> ${level.next.icon}`;
    else sub.innerHTML=`¡Eres una <strong>Leyenda</strong>! 🏆 Has completado todo el curso`;
    const grid=$('modulesGrid');
    grid.innerHTML=MODULES.map(m=>{
        const p=m.stats();let statsHtml='';
        if(m.id==='castelli')statsHtml=`<span><b>${p.lessonsDone}</b> lecciones</span><span><b>${p.castlesPassed}</b> castillos</span>`;
        else if(m.id==='citta')statsHtml=`<span><b>${p.done}</b> lugares</span><span>de 12</span>`;
        else statsHtml=`<span><b>${p.done}</b> conversaciones</span><span>de 14</span>`;
        return `<div class="module-card" onclick="showView('${m.view}')" style="--mod-color:${m.color};--mod-color-soft:${m.colorSoft};--mod-glow:${m.glow}"><div class="module-head"><div class="module-icon">${m.icon}</div><div class="module-titles"><div class="module-name">${m.short}</div><div class="module-desc">${m.desc}</div></div></div><div class="module-body"><div class="module-progress-top"><span class="label">Progreso</span><span class="pct">${p.percent}%</span></div><div class="module-bar"><div class="module-bar-fill" style="width:${p.percent}%"></div></div><div class="module-stats">${statsHtml}</div></div><div class="module-cta"><span>${p.percent>=100?'Repasar':(p.percent>0?'Continuar':'Empezar')}</span><span>→</span></div></div>`;
    }).join('');
    const cast=castleProgressStats();const ciud=cityProgressStats();const pers=personasProgressStats();
    $('statLessons').textContent=cast.lessonsDone;$('statCastles').textContent=cast.castlesPassed;$('statPlaces').textContent=ciud.done;$('statConversations').textContent=pers.done;
}
async function handleReset(){
    const ok1=await showModal({title:'¿Empezar de cero?',message:'Se borrarán <strong>todas</strong> las lecciones, castillos, lugares, conversaciones y la llave.',icon:'🔄',confirmText:'Sí, empezar de cero',cancelText:'Cancelar',danger:true});
    if(!ok1)return;
    const ok2=await showModal({title:'Última confirmación',message:'Esta acción <strong>no se puede deshacer</strong>. ¿Estás seguro?',icon:'⚠️',confirmText:'Sí, borrar todo',cancelText:'No, conservar',danger:true});
    if(!ok2)return;
    State.castles={lessons:{},castles:{},key:{s1:0,s2:0,s3:0,exam:0},certName:''};
    State.city={scores:{}};State.personas={chars:{}};
    saveCastles();saveCity();savePersonas();renderDashboard();
    showToast('Progreso borrado. ¡Empezamos de nuevo! 🚀','success');
}

