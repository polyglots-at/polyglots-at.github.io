let persSession=null;
function renderPersChars(){
    const grid=$('persCharsGrid');
    grid.innerHTML=CHARACTERS.map((c,i)=>{
        const done=!!State.personas.chars[c.id];
        const prevDone=i===0||!!State.personas.chars[CHARACTERS[i-1].id];
        const locked=!prevDone&&!done;
        let cls='char-card';if(done)cls+=' done';if(locked)cls+=' locked';else if(!done&&prevDone)cls+=' current';
        return `<div class="${cls}" data-cid="${c.id}">${locked?'<span class="char-lock">🔒</span>':''}<div class="char-avatar">${c.icon}</div><div class="char-name">${escHtml(c.name)}</div><div class="char-role">${escHtml(c.role)}</div><div class="char-topic">${escHtml(c.place.split('·')[1]?.trim()||'')}</div><div class="char-status${done?' done':''}">${done?'✓ Completado':(locked?'Bloqueado':'Disponible')}</div></div>`;
    }).join('');
    grid.querySelectorAll('.char-card').forEach(el=>{
        el.addEventListener('click',()=>{
            const c=CHARACTERS.find(x=>x.id===el.dataset.cid);if(!c)return;
            const i=CHARACTERS.indexOf(c);
            const prevDone=i===0||!!State.personas.chars[CHARACTERS[i-1].id];
            if(!prevDone&&!State.personas.chars[c.id]){showToast('Completa primero la conversación anterior','warn');return;}
            startPersonasDialogue(c);
        });
    });
    updatePersHeaderProgress();
}
function positionPersOwl(){const container=$('persMapContainer');const owl=$('persOwl');if(!container||!owl)return;owl.style.left='50%';owl.style.top='24px';}
function updatePersHeaderProgress(){const s=personasProgressStats();if($('persHeaderProgress'))$('persHeaderProgress').textContent=s.percent+'%';if($('persHeaderBar'))$('persHeaderBar').style.width=s.percent+'%';}
async function startPersonasDialogue(c){
    persSession={character:c,currentLine:0,passed:[],listening:false};
    $('persDlgAvatar').textContent=c.icon;
    $('persDlgName').innerHTML=`${escHtml(c.name)} <span class="dlg-role">${escHtml(c.role)}</span>`;
    $('persDlgPlace').textContent=c.place;
    showView('personaggi-dialogue');
    renderPersChat();
    updateMicBanner();
    const perm=await checkMicPermission();
    if(perm==='granted'){const banner=$('persMicBanner');banner.className='mic-banner ready';$('persMicBannerText').textContent='✅ Micrófono listo. Pulsa 🎤 en cada frase.';}
    else if(perm==='denied'){const banner=$('persMicBanner');banner.className='mic-banner blocked';$('persMicBannerText').textContent='⚠ Micrófono bloqueado. Puedes usar "He dicho esta frase" para simular.';}
    else{const banner=$('persMicBanner');banner.className='mic-banner prompt';$('persMicBannerText').textContent='🎙️ Pulsa 🎤 para autorizar el micrófono.';}
}
function updateMicBanner(){
    if(!persSession)return;
    const banner=$('persMicBanner');
    if(!micSupported){banner.className='mic-banner blocked';$('persMicBannerText').textContent='⚠ Tu navegador no soporta reconocimiento de voz. Usa "He dicho esta frase" para simular.';}
}
function renderPersChat(){
    if(!persSession)return;
    const c=persSession.character;
    const chat=$('persChat');
    chat.innerHTML=c.lines.map((l,i)=>{
        const passed=persSession.passed.includes(i);
        const active=i===persSession.currentLine&&!passed;
        return `<div class="bubble ${i%2===1?'poly':''} ${active?'active':''} ${passed?'passed':''}"><div class="avatar">${i%2===1?'🦉':c.icon}</div><div class="bubble-body"><div class="bubble-name">${i%2===1?'POLY':escHtml(c.name.toUpperCase())}${passed?'<span class="pass-mark">✓ superado</span>':''}</div><div class="bubble-text">${escHtml(l.en)}</div><div class="bubble-phon">[${escHtml(l.sp)}]</div><div class="bubble-trans">${escHtml(l.es)}</div><div class="bubble-actions"><button class="mini-btn" onclick="speak('${escAttr(cleanForSpeech(l.en))}',this)">🔊 Escuchar</button>${active?`<button class="mini-btn primary" id="btnMic" onclick="startMic(${i})">🎤 Repetir</button><button class="mini-btn" onclick="markPassed(${i})">He dicho la frase</button>`:''}</div>${active?`<div id="micPractice" class="practice" style="display:none"></div>`:''}</div></div>`;
    }).join('');
    const total=c.lines.length;const done=persSession.passed.length;
    $('persDlgProgressBar').style.width=((done/total)*100)+'%';
    $('persDlgProgressText').textContent=`Frase ${Math.min(done+1,total)} de ${total}`;
    const activeBubble=chat.querySelector('.bubble.active');
    if(activeBubble)activeBubble.scrollIntoView({behavior:'smooth',block:'center'});
}
function startMic(lineIdx){
    if(!persSession)return;
    if(!micSupported){showToast('Reconocimiento de voz no disponible. Usa "He dicho la frase".','warn');return;}
    const c=persSession.character;const line=c.lines[lineIdx];
    const practice=document.getElementById('micPractice');
    if(!practice)return;
    practice.style.display='block';
    practice.innerHTML=`<div class="mic-status listening" id="micStatus">🎙️ Escuchando... habla ahora</div><div id="micFeedback"></div>`;
    try{
        const rec=createRecognition();
        rec.onresult=(event)=>{
            const transcript=event.results[0][0].transcript;
            const ok=matchPhrase(transcript,line.en);
            const fb=document.getElementById('micFeedback');
            if(ok){playCorrectSound();fb.innerHTML=`<div class="fb ok">✓ ¡Muy bien! Has dicho: "${escHtml(transcript)}"</div>`;setTimeout(()=>markPassed(lineIdx),600);}
            else{playWrongSound();fb.innerHTML=`<div class="fb bad">✗ He oído: "${escHtml(transcript)}"<br>Inténtalo otra vez, o pulsa "He dicho la frase" si ya lo has intentado.</div><div class="practice-actions"><button class="pers-btn primary" onclick="startMic(${lineIdx})">🔁 Reintentar</button><button class="pers-btn" onclick="markPassed(${lineIdx})">He dicho la frase</button></div>`;}
        };
        rec.onerror=(event)=>{const fb=document.getElementById('micFeedback');if(fb)fb.innerHTML=`<div class="fb info">No se pudo escuchar (${event.error}). Pulsa 🎤 o "He dicho la frase".</div>`;};
        rec.onend=()=>{const st=document.getElementById('micStatus');if(st)st.classList.remove('listening');};
        rec.start();
    }catch(e){const fb=document.getElementById('micFeedback');if(fb)fb.innerHTML=`<div class="fb info">Error: ${escHtml(e.message)}</div>`;}
}
function matchPhrase(said,target){
    const norm=s=>s.toLowerCase().replace(/[¿¡.,!?;:'"«»]/g,'').replace(/\s+/g,' ').trim();
    const a=norm(said),b=norm(target);
    if(a===b)return true;
    const aWords=a.split(' '),bWords=b.split(' ');
    const common=aWords.filter(w=>bWords.includes(w)).length;
    return common/Math.max(bWords.length,1)>=0.6;
}
function markPassed(lineIdx){
    if(!persSession)return;
    if(!persSession.passed.includes(lineIdx))persSession.passed.push(lineIdx);
    const c=persSession.character;
    if(persSession.passed.length>=c.lines.length){
        State.personas.chars[c.id]=true;savePersonas();
        setTimeout(()=>finishPersonasDialogue(),500);
    }else{
        persSession.currentLine=Math.max(...persSession.passed)+1;
        if(persSession.currentLine>=c.lines.length)persSession.currentLine=c.lines.findIndex((_,i)=>!persSession.passed.includes(i));
        renderPersChat();
    }
}
function finishPersonasDialogue(){
    if(!persSession)return;
    const c=persSession.character;
    const total=c.lines.length;const pct=100;
    document.querySelectorAll('#persResStars .star').forEach((el,i)=>el.classList.toggle('lit',true));
    $('persResEmoji').textContent='🏆';
    $('persResTitle').textContent='¡Conversación completada!';
    $('persResSubtitle').textContent=`${c.icon} ${c.name} · ${c.role}`;
    $('persResScore').textContent=pct+'%';$('persResDetail').textContent=`${total} de ${total} frases superadas`;
    $('persResStatus').textContent='✅ CONVERSACIÓN SUPERADA';$('persResStatus').className='status passed';
    showView('personaggi-results');
    renderPersChars();
}
function retryPersonasDialogue(){if(!persSession)return;const c=persSession.character;startPersonasDialogue(c);}

