let audioCtx=null;
function getAudioCtx(){if(!audioCtx){const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return null;audioCtx=new AC();}if(audioCtx.state==='suspended')audioCtx.resume();return audioCtx;}
function playCorrectSound(){try{const ctx=getAudioCtx();if(!ctx)return;const now=ctx.currentTime;[523.25,659.25,783.99].forEach((freq,i)=>{const o=ctx.createOscillator(),g=ctx.createGain();o.type='sine';o.frequency.value=freq;const t=now+i*0.075;g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(0.16,t+0.015);g.gain.exponentialRampToValueAtTime(0.0008,t+0.32);o.connect(g).connect(ctx.destination);o.start(t);o.stop(t+0.36);});}catch(e){}}
function playWrongSound(){try{const ctx=getAudioCtx();if(!ctx)return;const now=ctx.currentTime;[220,164.81].forEach((freq,i)=>{const o=ctx.createOscillator(),g=ctx.createGain();o.type='triangle';o.frequency.value=freq;const t=now+i*0.13;g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(0.14,t+0.02);g.gain.exponentialRampToValueAtTime(0.0008,t+0.28);o.connect(g).connect(ctx.destination);o.start(t);o.stop(t+0.32);});}catch(e){}}

/* ============ VOICE (pt-BR) ============ */
let voices=[];
function loadVoices(){if('speechSynthesis' in window)voices=speechSynthesis.getVoices();}
if('speechSynthesis' in window){loadVoices();speechSynthesis.onvoiceschanged=loadVoices;}
function getVoice(lang){if(!voices.length)voices=speechSynthesis.getVoices();lang=lang||'pt-BR';if(lang.startsWith('pt')){return voices.find(v=>v.lang==='pt-BR'&&v.localService)||voices.find(v=>v.lang==='pt-BR')||voices.find(v=>v.lang==='pt-PT')||voices.find(v=>v.lang.startsWith('pt'));}if(lang.startsWith('es')){return voices.find(v=>v.lang==='es-ES'&&v.localService)||voices.find(v=>v.lang==='es-ES')||voices.find(v=>v.lang.startsWith('es'));}return voices.find(v=>v.lang.startsWith(lang.split('-')[0]));}
let speakingBtn=null;
function speak(text,btn,lang){if(!('speechSynthesis' in window))return;if(!text||!String(text).trim())return;lang=lang||'pt-BR';speechSynthesis.cancel();if(speakingBtn)speakingBtn.classList.remove('speaking');const u=new SpeechSynthesisUtterance(String(text));u.lang=lang;u.rate=0.85;u.pitch=1;const v=getVoice(lang);if(v)u.voice=v;if(btn){btn.classList.add('speaking');speakingBtn=btn;u.onend=()=>{btn.classList.remove('speaking');speakingBtn=null;};u.onerror=()=>{btn.classList.remove('speaking');speakingBtn=null;};}speechSynthesis.speak(u);}

/* ============ SPEECH RECOGNITION (pt-BR) ============ */
const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
let micRecognition=null, micSupported=!!SpeechRecognition;
function createRecognition(){if(!micSupported)return null;const r=new SpeechRecognition();r.lang='pt-BR';r.continuous=false;r.interimResults=false;r.maxAlternatives=1;return r;}
function checkMicPermission(){return new Promise(resolve=>{if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){resolve('unsupported');return;}navigator.mediaDevices.getUserMedia({audio:true}).then(stream=>{stream.getTracks().forEach(t=>t.stop());resolve('granted');}).catch(()=>resolve('denied'));});}

/* ============ TOAST & MODAL ============ */
function showToast(message,type,title){type=type||'info';const c=$('toastContainer');if(!c)return;const t=document.createElement('div');t.className='toast '+type;let icon='ℹ️';if(type==='warn'||type==='error')icon='⚠️';if(type==='success')icon='✅';t.innerHTML=`<span class="toast-icon">${icon}</span><div class="toast-text">${title?`<strong>${title}</strong><br>`:''}${message}</div>`;c.appendChild(t);setTimeout(()=>{t.classList.add('out');setTimeout(()=>t.remove(),320);},3800);}
function showModal({title,message,icon,confirmText,cancelText,danger}){return new Promise(resolve=>{const overlay=$('modalOverlay');const btnConfirm=$('modalConfirm');const btnCancel=$('modalCancel');$('modalIcon').textContent=icon||'⚠️';$('modalTitle').textContent=title;$('modalMessage').innerHTML=message;btnConfirm.textContent=confirmText||'Aceptar';btnConfirm.classList.toggle('danger',!!danger);if(cancelText){btnCancel.textContent=cancelText;btnCancel.style.display='';}else{btnCancel.style.display='none';}overlay.classList.add('active');const close=result=>{overlay.classList.remove('active');btnConfirm.onclick=null;btnCancel.onclick=null;overlay.querySelector('.modal-backdrop').onclick=null;resolve(result);};btnConfirm.onclick=()=>close(true);btnCancel.onclick=()=>close(false);overlay.querySelector('.modal-backdrop').onclick=()=>close(false);});}

