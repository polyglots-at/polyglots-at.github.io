.modal-actions button{flex:1;min-width:120px;padding:13px 18px;border-radius:14px;font-size:.88rem;font-weight:700;cursor:pointer;font-family:inherit;border:none}
.modal-cancel{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14)!important;color:#fbeee0}
.modal-confirm{background:linear-gradient(135deg,#34d399,#6ee7b7);color:#062012}
.modal-confirm.danger{background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff}
.toast-container{position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:4000;display:flex;flex-direction:column;gap:10px;width:calc(100% - 32px);max-width:440px;pointer-events:none}
.toast{background:rgba(10,38,18,.98);border:1px solid rgba(52,211,153,.5);border-radius:16px;padding:13px 16px;color:#fbeee0;font-size:.88rem;box-shadow:0 10px 35px rgba(0,0,0,.65);display:flex;align-items:flex-start;gap:10px;pointer-events:auto}
