.btn-instagram{background:linear-gradient(135deg,#f58529,#dd2a7b,#8134af);color:#fff;border:none;padding:12px 22px;border-radius:40px;font-weight:700;font-size:.85rem;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:8px;font-family:inherit}
.modal-overlay{position:fixed;inset:0;background:rgba(6,18,10,.85);backdrop-filter:blur(8px);z-index:5000;display:none;align-items:center;justify-content:center;padding:20px}
.modal-overlay.active{display:flex}
.modal-backdrop{position:absolute;inset:0}
.modal-box{position:relative;background:linear-gradient(165deg,rgba(21,58,31,.98),rgba(10,38,18,.98));border:1px solid rgba(52,211,153,.35);border-radius:24px;padding:26px 24px 20px;max-width:420px;width:100%;box-shadow:0 30px 80px rgba(0,0,0,.7);animation:modalPopIn .3s cubic-bezier(.34,1.56,.64,1)}
@keyframes modalPopIn{from{opacity:0;transform:scale(.9) translateY(20px)}to{opacity:1;transform:scale(1) translateY(0)}}
.modal-icon{font-size:2.6rem;text-align:center;margin-bottom:10px;line-height:1}
.modal-title{font-size:1.15rem;font-weight:800;color:#6ee7b7;text-align:center;margin-bottom:10px}
