function lessonPrev(){if(!lessonSession)return;const {data,phase}=lessonSession;if(phase==='welcome')return;if(phase==='content'){if(lessonSession.contentStep>0)lessonSession.contentStep--;else lessonSession.phase='welcome';}else if(phase==='practice'){lessonSession.phase='content';lessonSession.contentStep=data.sec.length-1;}else if(phase==='quiz')lessonSession.phase='practice';else if(phase==='complete')lessonSession.phase='quiz';renderLessonStep();}
